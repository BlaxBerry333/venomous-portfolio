---
import NotFound from "@/components/NotFound";
import RootLayout from "@/layouts/RootLayout.astro";
import { DEFAULT_LOCALE, loadNotFoundMeta } from "@/utils/i18n";
import { DEFAULT_THEME, THEME_STORAGE_KEY } from "@/utils/themes";

const meta = loadNotFoundMeta();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// tab title 用默认 locale —— 真实 title 由 NotFound 岛挂载后按探测 locale 改写
const tabTitle = meta.title[DEFAULT_LOCALE];
---

{
  /*
  404 是单份静态 HTML，无 locale / theme 段。RootLayout 不传 theme（SSR 不知道用哪套）；
  下方 inline 脚本在岛挂载前先把 <html data-theme> 设好，让 ThemeCriticalCSS 底色命中正确主题。
*/
}
<RootLayout locale={DEFAULT_LOCALE} title={tabTitle}>
  {
    /* 绘制前抢先定主题 —— 优先 localStorage 上次访问，回退默认；与 detectClientTheme 同序。
      键名 / 默认值经 data-* 传入，脚本内自取，避免 define:vars 的未用变量告警 */
  }
  <script is:inline data-key={THEME_STORAGE_KEY} data-fallback={DEFAULT_THEME}>
    {
      `
      (function () {
        var s = document.currentScript;
        var key = s.dataset.key;
        var fallback = s.dataset.fallback;
        try {
          var stored = localStorage.getItem(key);
          document.documentElement.dataset.theme =
            stored === "nebula" || stored === "sanguine" ? stored : fallback;
        } catch (_) {
          document.documentElement.dataset.theme = fallback;
        }
      })();
    `;
    }
  </script>

  <main id="portfolio--notFound" data-active-page="notFound">
    <NotFound client:only="react" meta={meta} base={base} />
  </main>
</RootLayout>

<style>
  main {
    position: relative;
    z-index: 10;
    min-height: 100dvh;
    overflow-x: clip;
  }
</style>
