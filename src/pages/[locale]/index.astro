---
import * as I18n from "@/i18n";
import * as Pages from "@/ui/pages";
import Document from "@/ui/layout/Document/Document.astro";

export function getStaticPaths() {
  return I18n.LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as I18n.Locale;
const messages = I18n.MESSAGES[locale];
---

<Document locale={locale} title={messages.UI.site} description={messages.PROFILE.about}>
  <Pages.Home client:only="react" locale={locale} />
</Document>
