---
import * as I18n from "@/i18n";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const works = JSON.stringify(I18n.Data.WORKS.map((work) => work.id));
const fallback = I18n.route(I18n.DEFAULT_LOCALE);
---

<!doctype html>
<html lang={I18n.MESSAGES[I18n.DEFAULT_LOCALE].UI.lang} data-works={works}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <noscript><meta http-equiv="refresh" content={`0; url=${fallback}`} /></noscript>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>Redirecting</title>
    <script>
      import { legacyTarget } from "@/i18n/route";

      const works: string[] = JSON.parse(document.documentElement.dataset.works ?? "[]");
      location.replace(legacyTarget(location.pathname, works));
    </script>
  </head>
  <body></body>
</html>
