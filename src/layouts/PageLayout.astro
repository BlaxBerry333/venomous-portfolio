---
import { ThemeNebula } from "@/themes/nebula";
import { ThemeSanguine } from "@/themes/sanguine";
import type { Locale } from "@/utils/i18n";
import type { Theme } from "@/utils/themes";
import RootLayout from "./RootLayout.astro";

interface Props {
  locale: Locale;
  theme: Theme;
  title?: string;
  description?: string;
  activePage?: "home" | "works" | "about" | "detail" | "designSystem";
}

const { locale, theme, title, description, activePage } = Astro.props;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<RootLayout locale={locale} theme={theme} title={title} description={description}>
  <main id={`portfolio--${activePage}`} data-active-page={activePage}>
    {
      theme === "nebula" && (
        <>
          <ThemeNebula.Background client:load />
          <ThemeNebula.LocaleSwitcher client:load {...{ locale, pathname, base }} />
          <ThemeNebula.ThemeSwitcher client:load {...{ theme, pathname, base }} />
        </>
      )
    }

    {
      theme === "sanguine" && (
        <>
          <ThemeSanguine.Background client:load />
          <ThemeSanguine.ScrollProgress client:load />
          <ThemeSanguine.LocaleSwitcher client:load {...{ locale, pathname, base }} />
          <ThemeSanguine.ThemeSwitcher client:load {...{ theme, pathname, base }} />
        </>
      )
    }

    <slot />
  </main>
</RootLayout>

<style>
  main {
    position: relative;
    z-index: 10;
    min-height: 100dvh;
    overflow-x: clip;
  }
</style>
