{
  "name": "venomous-portfolio",
  "type": "module",
  "version": "4.0.0",
  "description": "Chen's personal portfolio — a multi-theme showcase of work, experiments, and craft built with Astro and React.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "astro dev --force --mode development --open",
    "build": "astro build --mode production",
    "preview": "astro preview",
    "astro": "astro",
    "check:astro": "astro check",
    "check:eslint": "eslint --config configs/eslint.config.mjs \"src/**/*.{js,ts,tsx,astro}\" --cache --cache-location=./.cache/.eslintcache",
    "check:spell": "cspell --config configs/cspell.json \"**\" --no-progress --cache --cache-location=./.cache/.cspellcache",
    "check:prettier": "prettier --config configs/prettier.config.mjs --ignore-path configs/.prettierignore --check \"src/**/*.{js,ts,tsx,astro,mdx}\"",
    "check:stylelint": "stylelint --config configs/stylelint.config.mjs \"src/**/*.{css,scss}\" --cache --cache-location=./.cache/.stylelintcache",
    "format:eslint": "eslint --config configs/eslint.config.mjs --fix \"src/**/*.{js,ts,tsx,astro}\"",
    "format:prettier": "prettier --config configs/prettier.config.mjs --ignore-path configs/.prettierignore --write \"src/**/*.{js,ts,tsx,astro,mdx}\" --cache --cache-location=./.cache/.prettiercache",
    "format:stylelint": "stylelint --config configs/stylelint.config.mjs --fix \"src/**/*.{css,scss}\"",
    "check": "concurrently -g --kill-others-on-fail --names \"astro,eslint,prettier\" \"npm run check:astro\" \"npm run check:eslint\" \"npm run check:prettier\"",
    "format": "concurrently --names \"eslint,prettier\" \"npm run format:eslint\" \"npm run format:prettier\"",
    "clean-cache": "rm -rf .cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.4.2",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "astro": "^5.18.1",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.99.0",
    "three": "^0.169.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "concurrently": "^9.1.2",
    "cspell": "^9.8.0",
    "eslint": "^9.23.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0"
  },
  "packageManager": "npm@10.5.1"
}
