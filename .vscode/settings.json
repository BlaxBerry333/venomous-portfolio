{
    "editor.formatOnSave": true,
    "[astro][typescript][typescriptreact][javascript][javascriptreact][css][scss][mdx]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit",
        "source.organizeImports": "explicit",
    },
    "prettier.requireConfig": true,
    "prettier.configPath": "configs/prettier.config.mjs",
    "prettier.ignorePath": "configs/.prettierignore",
    "eslint.options": {
        "overrideConfigFile": "configs/eslint.config.mjs",
    },
    "stylelint.configFile": "configs/stylelint.config.mjs",
    "stylelint.validate": ["css", "scss"],
    "cSpell.import": ["${workspaceFolder}/configs/cspell.json"],
}
